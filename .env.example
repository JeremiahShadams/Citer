# ---- Citer: copy to .env and fill in secrets. Never commit .env. ----

# OpenAI (required for chat + embeddings)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# LangSmith tracing (optional but recommended)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=codebase-qa

# Postgres + Redis (host dev defaults; compose overrides host/port)
POSTGRES_USER=codeqa
POSTGRES_PASSWORD=codeqa
POSTGRES_DB=codeqa
DATABASE_URL=postgresql+psycopg://codeqa:codeqa@localhost:5432/codeqa
REDIS_URL=redis://localhost:6379/0

# GitHub (higher rate limits + private repos)
GITHUB_TOKEN=

# GitHub OAuth (optional, for login flow)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback
FRONTEND_URL=http://localhost:3000

# Auth
JWT_SECRET=dev-secret-change-me
JWT_EXPIRY_HOURS=168

# Frontend -> backend
NEXT_PUBLIC_API_URL=http://localhost:8000
